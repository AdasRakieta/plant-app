[Unit]
Description=Pedy private local vision AI bridge
Wants=network-online.target ollama.service
After=network-online.target ollama.service

[Service]
User=pedy
StateDirectory=pedy-ai
Group=pedy
EnvironmentFile=-/etc/pedy-ai.env
Environment=PEDY_AI_PORT=8788
Environment=PEDY_AI_PROVIDER=gemini
ExecStart=/usr/bin/python3 /opt/pedy/ai_server.py
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
